#!/bin/bash
#SBATCH -p normal
#SBATCH -n 1
#SBATCH -c 16
#SBATCH --mem-per-cpu=10G
#SBATCH -t 04:00:00
#SBATCH -o logs/job.%j.out
#SBATCH -e logs/job.%j.err

module load extenv/own
module load benchbatch

REG=test

mkdir results/$REG

benchbatch results \
    -r registries/$REG \
    -d results/$REG \
    -m measures.conf.R \
    -N $SLURM_JOB_CPUS_PER_NODE \
    -C 100 -v
