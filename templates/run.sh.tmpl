#!/bin/bash
#SBATCH -p normal
#SBATCH -n 1
#SBATCH -c 4
#SBATCH --mem-per-cpu=10G
#SBATCH -t 24:00:00
#SBATCH -o logs/job.%j.out
#SBATCH -e logs/job.%j.err

module load extenv/own
module load benchbatch

REG=test

benchbatch run \
    -m pegasus \
    -c resources/pegasus.conf.R
    -r registries/$REG \
    -l configs/${1}.conf.R \
    -N 4 \
    --resubmit_not_finished \
    --resubmit_errors
