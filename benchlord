#!/bin/bash

function main_help() {
    echo list of commands:
    echo help: print help
    echo launch: launch benchmark from config file
    echo status: print jobs done, still runing and errors
    echo results: extract performance measures from registry
}

function launch() {
    Rscript R/bench_experiment.R "$@"
}

function status() {
    Rscript R/probe_registry.R "$@"
}

function results() {
    Rscript R/extract_results.R "$@"
}

function main() {
    if ((${#} == 0)); then
        main_help 0;
        exit 0;
    fi

    case ${1} in
        help | launch | status | results )
            $1 "${@:2}";
            ;;
        * )
            echo "unknown command"
            main_help 1;
            exit 1;
            ;;
    esac
}

main "$@"
