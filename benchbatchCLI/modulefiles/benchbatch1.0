#%Module

proc ModulesHelp { } {
    puts sterr "This module the CLI for the benchbatch R package to the path"
}
module-whatis "This module the CLI for the benchbatch R package to the path"

prereq r/4.3.2
set basedir "/env/cnrgh/scratch_math_stats/legoff/benchbatchCLI"
prepend-path PATH "${basedir}/bin"
setenv BENCHBATCH_R_FILES "${basedir}/R"
